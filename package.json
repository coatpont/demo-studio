{
    "name": "demo-studio",
    "version": "0.1.0",
    "description": "Narrated demo videos of a web app, written by a coding agent from a catalog of its real features, played by Playwright and rendered by Remotion.",
    "license": "MIT",
    "type": "module",
    "bin": {
        "demo-studio": "./bin/demo-studio.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "bin",
        "dist",
        "src",
        "skills",
        "README.md"
    ],
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "prepare": "npm run build",
        "demo-studio": "node src/cli/main.ts",
        "format": "prettier --write 'src/**/*.{ts,tsx}' 'tests/*.ts' 'examples/**/*.ts' '*.ts'",
        "test:format": "prettier --check 'src/**/*.{ts,tsx}' 'tests/*.ts' 'examples/**/*.ts' '*.ts'",
        "test": "vitest run",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@remotion/bundler": "4.0.538",
        "@remotion/renderer": "4.0.538",
        "playwright-core": "^1.56.1",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "remotion": "4.0.538",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.7",
        "prettier": "^3.6.2",
        "typescript": "5.9.3",
        "vitest": "^3.2.4"
    }
}
